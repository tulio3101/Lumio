ENVIRONMENT=local
DEBUG=true
DATABASE_URL=postgresql+psycopg://lumio:lumio@localhost:5432/lumio
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Iniciar sesión con Google: client ID de OAuth de la app iOS (y web), separados por comas.
# Sin valor, POST /users/login/google responde 503 google_auth_unavailable.
# GOOGLE_CLIENT_IDS=123-abc.apps.googleusercontent.com
# Correo de alertas: «log» (solo local, escribe el correo en los logs) o «ses» (AWS).
EMAIL_BACKEND=log
# Base de los enlaces de la ubicación compartida que reciben los contactos (SCRUM-25).
PUBLIC_BASE_URL=http://localhost:8000
# Remitente verificado en SES; obligatorio con EMAIL_BACKEND=ses.
# SES_SENDER_EMAIL=no-reply@tu-dominio.com
# Base de datos DEDICADA a pruebas de integración (se borra en cada ejecución).
TEST_DATABASE_URL=postgresql+psycopg://lumio:lumio@localhost:5432/lumio_test
# Narración del entorno (ADR-308): disabled | fake (texto fijo, solo local) | bedrock.
NARRATION_BACKEND=fake
# Perfil de inferencia de Bedrock; solo con NARRATION_BACKEND=bedrock.
NARRATION_MODEL_ID=us.anthropic.claude-haiku-5-5
